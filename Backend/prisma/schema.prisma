// ─────────────────────────────────────────────────────────────────────────────
// FLASHCARDS (Spaced Repetition — SM-2)
// ─────────────────────────────────────────────────────────────────────────────

/// A deck is either personal (userId set) or course content (lessonId set).
/// Course decks are authored by a tutor alongside a lesson and revised by every
/// student taking it, which is why scheduling cannot live on the card — see
/// FlashcardProgress.
model FlashcardDeck {
  id          String      @id @default(uuid())
  /// Owner of a personal deck. Null for tutor-authored course decks.
  userId      String?
  /// Set when the deck is course content. It inherits the lesson's published
  /// state rather than needing its own approval queue.
  lessonId       String?
  tutorProfileId String?
  topicId     String?
  title       String
  description String?
  isPublic    Boolean     @default(false)
  cardCount   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user        User?          @relation(fields: [userId], references: [id])
  lesson      Lesson?        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  tutorProfile TutorProfile? @relation(fields: [tutorProfileId], references: [id])
  topic       Topic?         @relation(fields: [topicId], references: [id])
  cards       Flashcard[]

  @@index([userId])
  @@index([lessonId])
  @@map("flashcard_decks")
}

/// Pure content. Scheduling state deliberately does NOT live here: one deck is
/// revised by many students, so an easeFactor on the card would mean the first
/// student to review it rewrote everyone else's schedule.
model Flashcard {
  id             String    @id @default(uuid())
  deckId         String
  questionId     String?
  front          String
  back           String
  imageUrl       String?
  tags           String[]
  /// True for Claude-drafted cards. Unverified cards are never served to
  /// students — a wrong "correct" answer teaches the mistake.
  aiGenerated    Boolean   @default(false)
  isVerified     Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  deck           FlashcardDeck       @relation(fields: [deckId], references: [id], onDelete: Cascade)
  question       Question?           @relation(fields: [questionId], references: [id])
  reviews        FlashcardReview[]
  progress       FlashcardProgress[]

  @@index([deckId])
  @@map("flashcards")
}

/// One student's schedule for one card. This is what makes a deck shareable:
/// 500 students revising the same card each carry their own ease factor and
/// due date. Absence of a row means the student has never seen the card, which
/// is how "new" cards enter the queue.
model FlashcardProgress {
  id             String    @id @default(uuid())
  userId         String
  flashcardId    String
  easeFactor     Float     @default(2.5)
  repetitions    Int       @default(0)
  interval       Int       @default(0)
  nextReviewAt   DateTime  @default(now())
  lastReviewedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcard      Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@unique([userId, flashcardId])
  @@index([userId, nextReviewAt])
  @@map("flashcard_progress")
}

model FlashcardReview {
  id           String                @id @default(uuid())
  userId       String
  flashcardId  String
  result       FlashcardReviewResult
  easeFactor   Float                 @default(2.5)
  interval     Int                   @default(1)
  repetitions  Int                   @default(0)
  nextReviewAt DateTime
  reviewedAt   DateTime              @default(now())

  user         User      @relation(fields: [userId], references: [id])
  flashcard    Flashcard @relation(fields: [flashcardId], references: [id])

  @@index([userId, nextReviewAt])
  @@map("flashcard_reviews")
}

