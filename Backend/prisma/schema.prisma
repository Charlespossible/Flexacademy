// FlexAcademy — Prisma Schema
// DB: PostgreSQL | ORM: Prisma v5
// Updated: Full platform schema including AI-Tutor collaboration pipeline
//          (StudentTutorAssignment, LearningGap, TutorInsight,
//           TutorIntervention, ExamReadinessCertification)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  STUDENT
  TUTOR
  PARENT
  SCHOOL_ADMIN
  ADMIN
  SUPER_ADMIN
}

enum SubscriptionTier {
  FREE
  BASIC
  PRO
  ELITE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  TRIAL
}

enum ContentType {
  VIDEO
  TEXT
  QUIZ
  FLASHCARD
  PAST_QUESTION
  LIVE_CLASS
  DOCUMENT
}

enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXAM_READY
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  ESSAY
  FILL_IN_BLANK
  DRAG_AND_DROP
}

enum ExamCategory {
  WAEC
  JAMB
  NECO
  GCE
  COMMON_ENTRANCE
  IGCSE
  SAT
  IELTS
  GMAT
  GRE
  CUSTOM
}

enum SessionStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum NotificationType {
  // Existing
  STUDY_REMINDER
  BADGE_EARNED
  STREAK_MILESTONE
  EXAM_REMINDER
  NEW_CONTENT
  RESULT_READY
  LEADERBOARD_UPDATE
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  TUTOR_APPROVED
  PARENT_ALERT
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  SYSTEM
  ANNOUNCEMENT
  // AI-Tutor pipeline notifications
  GAP_DETECTED
  TUTOR_INSIGHT_READY
  STUDENT_IMPROVED
  EXAM_READINESS_UPDATED
  INTERVENTION_REQUIRED
  CERTIFICATION_READY
  // Account standing
  TUTOR_SUSPENDED
  TUTOR_REINSTATED
  COURSE_APPROVED
  COURSE_REJECTED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
  WHATSAPP
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

// Distinguishes one-off bookings from ongoing assignment sessions
enum SessionType {
  ONE_OFF
  ASSIGNMENT_SESSION
  REMEDIAL
}

enum TutorApplicationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

/// Lifecycle of tutor-authored course content, from draft to live.
/// `isPublished` on Course stays the flag student-facing queries filter on;
/// this tracks how it got there and who signed it off.
enum CourseStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

enum ReportReason {
  INCORRECT_ANSWER
  OUTDATED_CONTENT
  POOR_EXPLANATION
  DUPLICATE
  OFFENSIVE
  OTHER
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum ExamSimulationStatus {
  IN_PROGRESS
  SUBMITTED
  TIMED_OUT
  ABANDONED
}

enum StudyPlanStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ABANDONED
}

enum FlashcardReviewResult {
  AGAIN
  HARD
  GOOD
  EASY
}

enum LicenseType {
  SCHOOL
  INSTITUTION
  CORPORATE
}

// ── AI-Tutor Pipeline Enums ───────────────────────────────────────────────────

enum AssignmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  TERMINATED
}

enum GapSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum GapStatus {
  OPEN
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  REGRESSED
}

enum CertificationStatus {
  PENDING_REVIEW
  CERTIFIED
  DEFERRED
  REVOKED
}

// ─────────────────────────────────────────────────────────────────────────────
// USERS & AUTH
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  phone            String?   @unique
  passwordHash     String?
  firstName        String
  lastName         String
  avatar           String?
  role             Role      @default(STUDENT)
  isEmailVerified  Boolean   @default(false)
  isPhoneVerified  Boolean   @default(false)
  /// Hard deactivation — blocks login entirely. Reserve for closed/banned
  /// accounts. Routine moderation uses the suspension fields below instead.
  isActive         Boolean   @default(true)

  // ── Soft suspension ──────────────────────────────────────────────────────
  // A suspended user CAN still sign in and see why, and appeal. What they lose
  // is the ability to act: tutors can't author or earn, and their student
  // assignments are paused. Suspension is "active" when suspendedAt is set —
  // deliberately no redundant boolean, which could drift out of sync.
  suspendedAt      DateTime?
  suspensionReason String?
  suspendedBy      String?   // admin User.id

  googleId         String?   @unique
  refreshTokenHash String?
  lastLoginAt      DateTime?
  schoolId         String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Existing relations
  studentProfile       StudentProfile?
  tutorProfile         TutorProfile?
  subscription         Subscription?
  enrollments          Enrollment[]
  quizAttempts         QuizAttempt[]
  studySessions        StudySession[]
  notifications        Notification[]
  notificationPrefs    NotificationPreference[]
  deviceTokens         DeviceToken[]
  payments             Payment[]
  badges               UserBadge[]
  progressRecords      LearningProgress[]
  lessonProgress       LessonProgress[]
  leaderboardEntries   LeaderboardEntry[]
  aiSessions           AiTutorSession[]
  liveClassBookings    LiveClassBooking[]
  auditLogs            AuditLog[]
  bookmarks            Bookmark[]
  certificates         Certificate[]
  parentLinks          ParentStudentLink[]  @relation("ParentUser")
  childLinks           ParentStudentLink[]  @relation("ChildUser")
  parentAlerts         ParentAlert[]        @relation("ParentAlerts")
  studyPlans           StudyPlan[]
  flashcardDecks       FlashcardDeck[]
  flashcardReviews     FlashcardReview[]
  flashcardProgress    FlashcardProgress[]
  examSimulations      ExamSimulation[]
  contentReports       ContentReport[]
  tutorReviews         TutorReview[]        @relation("ReviewerUser")
  tutorBookings        Booking[]            @relation("StudentBooking")
  announcements        Announcement[]
  referralsMade        Referral[]           @relation("ReferrerUser")
  referralsReceived    Referral[]           @relation("ReferredUser")
  promoCodes           PromoCodeUsage[]
  school               School?              @relation(fields: [schoolId], references: [id])

  // AI-Tutor pipeline relations
  studentAssignments        StudentTutorAssignment[]       @relation("StudentAssignments")
  learningGaps              LearningGap[]                  @relation("StudentGaps")
  tutorInsightsReceived     TutorInsight[]                 @relation("StudentInsights")
  tutorInterventionsReceived TutorIntervention[]           @relation("StudentInterventions")
  examCertifications        ExamReadinessCertification[]   @relation("StudentCertifications")

  @@index([email])
  @@index([role])
  @@index([schoolId])
  @@map("users")
}

model StudentProfile {
  id             String       @id @default(uuid())
  userId         String       @unique
  gradeLevel     String
  curriculum     String
  school         String?
  state          String?
  country        String       @default("Nigeria")
  studyGoal      String?
  targetExams          ExamCategory[]
  preferredSubjectIds  String[]
  targetYear           Int?
  studyStreakDays       Int          @default(0)
  longestStreak  Int          @default(0)
  totalXp        Int          @default(0)
  weeklyGoalMins Int          @default(120)
  lastStudyDate  DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

model TutorProfile {
  id                  String                 @id @default(uuid())
  userId              String                 @unique
  bio                 String?
  qualifications      String[]
  specializations     String[]
  subjectIds          String[]
  yearsOfExperience   Int                    @default(0)
  hourlyRate          Decimal?               @db.Decimal(10, 2)
  currency            String                 @default("NGN")
  rating              Decimal                @default(0) @db.Decimal(3, 2)
  totalReviews        Int                    @default(0)
  totalSessions       Int                    @default(0)
  maxStudents         Int                    @default(10) // max concurrent assigned students
  isVerified          Boolean                @default(false)
  applicationStatus   TutorApplicationStatus @default(PENDING)
  availabilitySlots   Json?                  // [{dayOfWeek, startTime, endTime}]
  bankDetails         Json?                  // encrypted bank/payout info
  totalEarnings       Decimal                @default(0) @db.Decimal(12, 2)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  liveClasses         LiveClass[]
  bookings            Booking[]
  reviews             TutorReview[]
  application         TutorApplication?
  earnings            TutorEarning[]

  // AI-Tutor pipeline relations
  assignments         StudentTutorAssignment[]
  insights            TutorInsight[]
  interventions       TutorIntervention[]
  courses             Course[]               // content this tutor authored
  flashcardDecks      FlashcardDeck[]        // revision decks attached to lessons

  @@map("tutor_profiles")
}

model TutorApplication {
  id              String                 @id @default(uuid())
  tutorProfileId  String                 @unique
  status          TutorApplicationStatus @default(PENDING)
  cvUrl           String?
  idDocumentUrl   String?
  coverLetter     String?
  reviewNote      String?
  reviewedBy      String?
  reviewedAt      DateTime?
  submittedAt     DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  tutorProfile    TutorProfile           @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  @@map("tutor_applications")
}

model TutorEarning {
  id             String       @id @default(uuid())
  tutorProfileId String
  bookingId      String       @unique
  grossAmount    Decimal      @db.Decimal(10, 2)
  platformFee    Decimal      @db.Decimal(10, 2)
  netAmount      Decimal      @db.Decimal(10, 2)
  currency       String       @default("NGN")
  isPaid         Boolean      @default(false)
  paidAt         DateTime?
  createdAt      DateTime     @default(now())

  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id])
  booking        Booking      @relation(fields: [bookingId], references: [id])

  @@index([tutorProfileId])
  @@map("tutor_earnings")
}

model TutorReview {
  id             String       @id @default(uuid())
  tutorProfileId String
  reviewerId     String
  bookingId      String       @unique
  rating         Int
  comment        String?
  isPublic       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id])
  reviewer       User         @relation("ReviewerUser", fields: [reviewerId], references: [id])
  booking        Booking      @relation(fields: [bookingId], references: [id])

  @@index([tutorProfileId])
  @@map("tutor_reviews")
}

model ParentStudentLink {
  id           String    @id @default(uuid())
  parentId     String
  studentId    String
  nickname     String?
  isVerified   Boolean   @default(false)
  createdAt    DateTime  @default(now())

  parent       User      @relation("ParentUser", fields: [parentId], references: [id])
  child        User      @relation("ChildUser", fields: [studentId], references: [id])
  alerts       ParentAlert[]

  @@unique([parentId, studentId])
  @@map("parent_student_links")
}

model ParentAlert {
  id              String            @id @default(uuid())
  linkId          String
  parentId        String
  alertType       String            // "inactivity" | "low_score" | "streak_broken" | "gap_detected"
  message         String
  inactivityDays  Int?
  minScorePercent Int?
  isRead          Boolean           @default(false)
  createdAt       DateTime          @default(now())

  link            ParentStudentLink @relation(fields: [linkId], references: [id])
  parent          User              @relation("ParentAlerts", fields: [parentId], references: [id])

  @@index([parentId])
  @@map("parent_alerts")
}

// ─────────────────────────────────────────────────────────────────────────────
// SCHOOL / INSTITUTION (B2B)
// ─────────────────────────────────────────────────────────────────────────────

model School {
  id            String      @id @default(uuid())
  name          String
  slug          String      @unique
  address       String?
  state         String?
  country       String      @default("Nigeria")
  contactEmail  String?
  contactPhone  String?
  logoUrl       String?
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  users         User[]
  licenses      SchoolLicense[]

  @@map("schools")
}

model SchoolLicense {
  id             String           @id @default(uuid())
  schoolId       String
  licenseType    LicenseType      @default(SCHOOL)
  tier           SubscriptionTier @default(PRO)
  maxStudents    Int              @default(100)
  activeStudents Int              @default(0)
  startsAt       DateTime
  expiresAt      DateTime
  isActive       Boolean          @default(true)
  pricePerSeat   Decimal?         @db.Decimal(10, 2)
  totalPaid      Decimal          @default(0) @db.Decimal(12, 2)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  school         School           @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
  @@map("school_licenses")
}

// ─────────────────────────────────────────────────────────────────────────────
// SUBSCRIPTIONS & PAYMENTS
// ─────────────────────────────────────────────────────────────────────────────

model Subscription {
  id                 String             @id @default(uuid())
  userId             String             @unique
  tier               SubscriptionTier   @default(FREE)
  status             SubscriptionStatus @default(TRIAL)
  stripeCustomerId   String?
  stripeSubId        String?
  paystackCustomerId String?
  paystackSubCode    String?
  nombaCustomerId    String?
  nombaTokenKey      String?  // stored card token for recurring billing
  // Which rung of the ladder was bought, and the version of pricing.config.json
  // it was sold under. Rule 4: a price change must never reprice an existing
  // subscriber, so renewal reads these rather than today's config.
  planId             String?
  termMonths         Int?
  pricingConfigVersion String?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  trialEndsAt        DateTime?
  promoCodeId        String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments           Payment[]
  promoCode          PromoCode?         @relation(fields: [promoCodeId], references: [id])

  @@map("subscriptions")
}

model Payment {
  id             String        @id @default(uuid())
  userId         String
  subscriptionId String?
  bookingId      String?       @unique
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("NGN")
  status         PaymentStatus @default(PENDING)
  provider       String        // "stripe" | "paystack" | "flutterwave"
  providerRef    String?       @unique
  metadata       Json?
  refundedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user           User          @relation(fields: [userId], references: [id])
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  booking        Booking?      @relation(fields: [bookingId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("payments")
}

model PromoCode {
  id              String           @id @default(uuid())
  code            String           @unique
  description     String?
  discountType    String           // "percent" | "fixed"
  discountValue   Decimal          @db.Decimal(10, 2)
  maxUses         Int?
  currentUses     Int              @default(0)
  minTier         SubscriptionTier?
  isActive        Boolean          @default(true)
  expiresAt       DateTime?
  createdAt       DateTime         @default(now())

  subscriptions   Subscription[]
  usages          PromoCodeUsage[]

  @@map("promo_codes")
}

model PromoCodeUsage {
  id          String    @id @default(uuid())
  promoCodeId String
  userId      String
  usedAt      DateTime  @default(now())

  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@unique([promoCodeId, userId])
  @@map("promo_code_usages")
}

model Referral {
  id           String    @id @default(uuid())
  referrerId   String
  referredId   String    @unique
  code         String    @unique
  isConverted  Boolean   @default(false)
  rewardGiven  Boolean   @default(false)
  convertedAt  DateTime?
  createdAt    DateTime  @default(now())

  referrer     User      @relation("ReferrerUser", fields: [referrerId], references: [id])
  referred     User      @relation("ReferredUser", fields: [referredId], references: [id])

  @@index([referrerId])
  @@map("referrals")
}

// ─────────────────────────────────────────────────────────────────────────────
// TUTOR BOOKING
// ─────────────────────────────────────────────────────────────────────────────

model Booking {
  id             String        @id @default(uuid())
  studentId      String
  tutorProfileId String
  subject        String
  topic          String?
  scheduledAt    DateTime
  durationMins   Int           @default(60)
  status         BookingStatus @default(PENDING)
  sessionType    SessionType   @default(ONE_OFF)
  assignmentId   String?       // links to ongoing StudentTutorAssignment if not one-off
  meetingUrl     String?
  studentNotes   String?
  tutorNotes     String?
  cancelReason   String?
  cancelledBy    String?
  completedAt    DateTime?
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("NGN")
  liveClassId    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  student        User                    @relation("StudentBooking", fields: [studentId], references: [id])
  tutorProfile   TutorProfile            @relation(fields: [tutorProfileId], references: [id])
  assignment     StudentTutorAssignment? @relation(fields: [assignmentId], references: [id])
  liveClass      LiveClass?              @relation(fields: [liveClassId], references: [id])
  payment        Payment?
  review         TutorReview?
  earning        TutorEarning?
  intervention   TutorIntervention?      // set when this session is a tutor intervention

  @@index([studentId])
  @@index([tutorProfileId])
  @@index([assignmentId])
  @@index([scheduledAt])
  @@map("bookings")
}

// ─────────────────────────────────────────────────────────────────────────────
// CURRICULUM & CONTENT
// ─────────────────────────────────────────────────────────────────────────────

model Subject {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  icon        String?
  color       String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  topics      Topic[]
  courses     Course[]
  assignments StudentTutorAssignment[]

  @@map("subjects")
}

model Topic {
  id          String    @id @default(uuid())
  subjectId   String
  name        String
  slug        String
  description String?
  order       Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  subject          Subject          @relation(fields: [subjectId], references: [id])
  lessons          Lesson[]
  questions        Question[]
  flashcardDecks   FlashcardDeck[]
  studyPlanItems   StudyPlanItem[]
  topicMasteries   TopicMastery[]
  learningGaps     LearningGap[]
  studySessions    StudySession[]

  @@unique([subjectId, slug])
  @@index([subjectId])
  @@map("topics")
}

model Course {
  id             String           @id @default(uuid())
  subjectId      String
  title          String
  slug           String           @unique
  description    String?
  thumbnail      String?
  difficulty     DifficultyLevel  @default(BEGINNER)
  gradeLevel     String?
  curriculum     String?
  isFree         Boolean          @default(false)
  requiredTier   SubscriptionTier @default(FREE)
  totalDuration  Int              @default(0)
  isPublished    Boolean          @default(false)
  publishedAt    DateTime?
  totalLessons   Int              @default(0)

  // ── Authorship & review ──────────────────────────────────────────────────
  // Nullable: courses seeded before tutor authoring existed have no author.
  // Revenue share is attributed through this field.
  tutorProfileId String?
  status         CourseStatus     @default(DRAFT)
  submittedAt    DateTime?
  reviewedBy     String?          // admin User.id
  reviewedAt     DateTime?
  reviewNote     String?          // required by the API when rejecting

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  subject         Subject           @relation(fields: [subjectId], references: [id])
  tutorProfile    TutorProfile?     @relation(fields: [tutorProfileId], references: [id])
  lessons         Lesson[]
  enrollments     Enrollment[]
  progressRecords LearningProgress[]
  certificates    Certificate[]
  reviews         CourseReview[]

  @@index([subjectId])
  @@index([isPublished])
  @@index([tutorProfileId])       // "my courses" on the tutor dashboard
  @@index([status])               // admin review queue
  @@map("courses")
}

model CourseReview {
  id        String   @id @default(uuid())
  courseId  String
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course    Course   @relation(fields: [courseId], references: [id])

  @@unique([courseId, userId])
  @@index([courseId])
  @@map("course_reviews")
}

model Lesson {
  id           String      @id @default(uuid())
  courseId     String
  topicId      String?
  title        String
  slug         String
  contentType  ContentType
  content      String?
  videoUrl     String?
  /// Cloudinary public_id for videoUrl. Stored rather than parsed back out of
  /// the URL, which is unreliable once transformations/versions are applied.
  /// Needed to verify, replace and delete the asset.
  videoPublicId String?
  duration     Int?
  order        Int         @default(0)
  isFree       Boolean     @default(false)
  isPublished  Boolean     @default(false)
  aiSummary    String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  course         Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  topic          Topic?           @relation(fields: [topicId], references: [id])
  studySessions  StudySession[]
  lessonProgress LessonProgress[]
  bookmarks      Bookmark[]
  flashcardDecks FlashcardDeck[]

  @@unique([courseId, slug])
  @@index([courseId])
  @@map("lessons")
}

model LessonProgress {
  id          String    @id @default(uuid())
  userId      String
  lessonId    String
  isCompleted Boolean   @default(false)
  watchedSecs Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id])
  lesson      Lesson    @relation(fields: [lessonId], references: [id])

  @@unique([userId, lessonId])
  @@index([userId])
  @@map("lesson_progress")
}

model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  lessonId  String
  note      String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  lesson    Lesson   @relation(fields: [lessonId], references: [id])

  @@unique([userId, lessonId])
  @@map("bookmarks")
}

// ─────────────────────────────────────────────────────────────────────────────
// EXAM QUESTIONS & QUIZZES
// ─────────────────────────────────────────────────────────────────────────────

model Question {
  id             String          @id @default(uuid())
  topicId        String?
  subjectId      String?
  examCategory   ExamCategory?
  year           Int?
  questionType   QuestionType    @default(MULTIPLE_CHOICE)
  body           String
  imageUrl       String?
  options        Json?           // [{id, text, isCorrect}]
  correctAnswer  String?
  explanation    String?
  difficulty     DifficultyLevel @default(INTERMEDIATE)
  marks          Int             @default(1)
  aiGenerated    Boolean         @default(false)
  tags           String[]
  isVerified     Boolean         @default(false)
  isActive       Boolean         @default(true)
  usageCount     Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  topic          Topic?                 @relation(fields: [topicId], references: [id])
  quizQuestions  QuizQuestion[]
  attemptAnswers AttemptAnswer[]
  examAnswers    ExamSimulationAnswer[]
  reports        ContentReport[]
  flashcards     Flashcard[]

  @@index([examCategory, year])
  @@index([topicId])
  @@index([subjectId])
  @@map("questions")
}

model Quiz {
  id               String           @id @default(uuid())
  title            String
  description      String?
  examCategory     ExamCategory?
  subjectId        String?
  gradeLevel       String?
