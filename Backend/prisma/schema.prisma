// ─────────────────────────────────────────────────────────────────────────────
// AI-TUTOR COLLABORATION PIPELINE
// The models below form the core of the hybrid AI + human tutor system.
// Flow: AI detects gap → creates LearningGap → generates TutorInsight →
//       tutor logs TutorIntervention → AI re-evaluates → loop until
//       ExamReadinessCertification is issued.
// ─────────────────────────────────────────────────────────────────────────────

// Persistent ongoing student-tutor relationship (not a one-off booking)
model StudentTutorAssignment {
  id             String           @id @default(uuid())
  studentId      String
  tutorProfileId String
  subjectId      String
  status         AssignmentStatus @default(ACTIVE)
  startedAt      DateTime         @default(now())
  endedAt        DateTime?
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  student        User             @relation("StudentAssignments", fields: [studentId], references: [id])
  tutorProfile   TutorProfile     @relation(fields: [tutorProfileId], references: [id])
  subject        Subject          @relation(fields: [subjectId], references: [id])
  gaps           LearningGap[]
  studyPlans     StudyPlan[]
  bookings       Booking[]
  certifications ExamReadinessCertification[]

  @@index([studentId])
  @@index([tutorProfileId])
  @@index([status])
  @@map("student_tutor_assignments")
}

// Formal record of an AI-detected knowledge gap with full lifecycle tracking
model LearningGap {
  id                 String                  @id @default(uuid())
  studentId          String
  assignmentId       String?
  topicId            String
  subjectId          String
  severity           GapSeverity             @default(MEDIUM)
  status             GapStatus               @default(OPEN)
  masteryAtDetection Decimal                 @db.Decimal(5, 2)
  evidence           Json                    // {quizScores, examScores, attempts, patterns}
  detectedAt         DateTime                @default(now())
  resolvedAt         DateTime?
  resolvedMastery    Decimal?                @db.Decimal(5, 2)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  student            User                    @relation("StudentGaps", fields: [studentId], references: [id])
  assignment         StudentTutorAssignment? @relation(fields: [assignmentId], references: [id])
  topic              Topic                   @relation(fields: [topicId], references: [id])
  insights           TutorInsight[]

  @@index([studentId, status])
  @@index([assignmentId])
  @@map("learning_gaps")
}

// AI-generated brief delivered to the assigned tutor when a gap is detected
model TutorInsight {
  id                  String       @id @default(uuid())
  gapId               String
  tutorProfileId      String
  studentId           String
  aiSummary           String       // human-readable AI brief
  recommendedApproach String?
  focusAreas          Json?        // [{topic, suggestion, priority}]
  isRead              Boolean      @default(false)
  readAt              DateTime?
  isActedOn           Boolean      @default(false)
  actedOnAt           DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  gap                 LearningGap  @relation(fields: [gapId], references: [id])
  tutorProfile        TutorProfile @relation(fields: [tutorProfileId], references: [id])
  student             User         @relation("StudentInsights", fields: [studentId], references: [id])
  interventions       TutorIntervention[]

  @@index([tutorProfileId, isRead])
  @@index([studentId])
  @@map("tutor_insights")
}

// Records what the tutor did after receiving an AI insight — closes the feedback loop
model TutorIntervention {
  id             String       @id @default(uuid())
  insightId      String
  tutorProfileId String
  studentId      String
  bookingId      String?      @unique // linked session if intervention was a booked session
  action         String       // description of what the tutor did
  notes          String?
  completedAt    DateTime     @default(now())
  aiReEvaluated  Boolean      @default(false) // has AI re-checked mastery post-intervention?
  postMastery    Decimal?     @db.Decimal(5, 2)
  createdAt      DateTime     @default(now())

  insight        TutorInsight @relation(fields: [insightId], references: [id])
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id])
  student        User         @relation("StudentInterventions", fields: [studentId], references: [id])
  booking        Booking?     @relation(fields: [bookingId], references: [id])

  @@index([insightId])
  @@index([studentId])
  @@map("tutor_interventions")
}

// Performance gate — AI scores readiness, tutor co-signs to certify student exam-ready
model ExamReadinessCertification {
  id               String              @id @default(uuid())
  studentId        String
  assignmentId     String?
  examCategory     ExamCategory
  aiReadinessScore Decimal             @db.Decimal(5, 2)
  subjectBreakdown Json                // {subjectId: score, ...}
  openGapsCount    Int                 @default(0)
  status           CertificationStatus @default(PENDING_REVIEW)
  tutorReviewedBy  String?             // tutorProfileId of co-signer
  tutorCoSignedAt  DateTime?
  tutorNotes       String?
  certifiedAt      DateTime?
  deferredReason   String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  student          User                     @relation("StudentCertifications", fields: [studentId], references: [id])
  assignment       StudentTutorAssignment?  @relation(fields: [assignmentId], references: [id])

  @@index([studentId, status])
  @@index([examCategory])
  @@map("exam_readiness_certifications")
}
