# FlexAcademy — Backend environment template
#
# Copy to .env and fill in. .env is gitignored; this file is not.
#   cp .env.example .env
#
# Keys are grouped by whether the application actually reads them.

# ═══════════════════════════════════════════════════════════════════════════
# REQUIRED — the server will not work correctly without these
# ═══════════════════════════════════════════════════════════════════════════

# ─── Runtime ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_VERSION=v1

# ─── Database (read by Prisma via prisma/schema.prisma) ────────────────────
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=
# Only needed for `prisma migrate dev` on some hosted Postgres providers
DATABASE_SHADOW_URL=

# ─── Auth ──────────────────────────────────────────────────────────────────
# Generate each with: openssl rand -base64 48
# These MUST be different from each other.
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS / redirects ──────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173          # prod: https://flexacademy.ng
FRONTEND_URL=http://localhost:5173        # prod: https://flexacademy.ng

# ─── Anthropic (AI tutor, gap detection, study plans) ──────────────────────
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Model ID. Do not append a date suffix — this string is complete as written.
ANTHROPIC_MODEL=claude-sonnet-5

# ═══════════════════════════════════════════════════════════════════════════
# OPTIONAL — features degrade or disable without these
# ═══════════════════════════════════════════════════════════════════════════

# ─── Redis (caching, rate limiting) ────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ─── Google OAuth ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback   # prod: https://api.flexacademy.ng/api/v1/auth/google/callback

# ─── Nomba (payments) ──────────────────────────────────────────────────────
NOMBA_BASE_URL=https://api.nomba.com
NOMBA_CLIENT_ID=
NOMBA_CLIENT_SECRET=
NOMBA_ACCOUNT_ID=
# Used to verify webhook signatures — required for live payments
NOMBA_WEBHOOK_SECRET=

# ─── Internal service auth ─────────────────────────────────────────────────
# Shared secret for internal/cron endpoints. openssl rand -hex 32
INTERNAL_API_KEY=

# ─── Rate limiting ─────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ─── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=debug

# ─── Feature flags ─────────────────────────────────────────────────────────
ENABLE_AI_TUTOR=true

# ═══════════════════════════════════════════════════════════════════════════
# RESERVED — present in some environments but NOT currently read by src/.
# Safe to leave blank. Remove once you've confirmed they're not coming back.
# ═══════════════════════════════════════════════════════════════════════════

APP_NAME=FlexAcademy
APP_URL=http://localhost:5000              # prod: https://api.flexacademy.ng
LOG_FORMAT=dev
ENABLE_LIVE_CLASSES=false
ENABLE_LEADERBOARD=true

# Email — no mailer is wired up yet
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
FROM_NAME=

# Superseded by Nomba — no Stripe/Paystack code path exists
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# No OpenAI client is instantiated anywhere in src/
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# No upload pipeline is wired up yet
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
