# ─── Secrets ──────────────────────────────────────────────────────────────────
# Never commit real credentials. Track .env.example instead (see negation below).
.env
.env.*
*.pem
*.key

# Keep the templates
!.env.example
!.env.*.example

# ─── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ─── Build output ─────────────────────────────────────────────────────────────
dist/
build/
out/
.vite/
*.tsbuildinfo

# ─── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Test / coverage ──────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ─── Editor & OS ──────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db

# ─── Caches ───────────────────────────────────────────────────────────────────
.cache/
.temp/
.eslintcache
.turbo/

# ─── Prisma ───────────────────────────────────────────────────────────────────
# Migrations ARE tracked; only the generated client is ignored.
Backend/prisma/generated/
